{
  "name": "obsidian-vault-terminal",
  "version": "1.0.0",
  "description": "Obsidian plugin: embedded terminal with action buttons and path-link conversion",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc --noEmit --skipLibCheck && node esbuild.config.mjs production",
    "version": "node version-bump.mjs && git add manifest.json versions.json",
    "format": "prettier --write \"src/**/*.ts\""
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "files": [
    "main.js",
    "styles.css",
    "manifest.json"
  ],
  "dependencies": {
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/addon-search": "^0.15.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.11.0",
    "@xterm/xterm": "^5.0.0",
    "ansi_up": "^6.0.2",
    "node-pty": "^1.0.0"
  },
  "devDependencies": {
    "@types/node": "^16.0.0",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "latest",
    "prettier": "^3.8.3",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tslib": "^2.4.0",
    "typescript": "^5.0.0"
  }
}
